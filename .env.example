# ---------------------------------------------------------------------------
# تنظیمات لایه‌ی داده در فرانت
# ---------------------------------------------------------------------------
# در development، mock به‌صورت پیش‌فرض فعال است تا رابط عمومی بدون Fastify
# محلی هم بارگذاری شود. فقط هنگام اجرای Fastify محلی، این مقدار را false کنید.
# این پرچم در build تولیدی adapter واقعی را جایگزین نمی‌کند.
VITE_USE_MOCK=true

# پیشوند API؛ nginx مسیر /api را به Fastify هدایت می‌کند و نسخه در مسیر است.
VITE_API_BASE=/api/v1

# فقط برای `npm run dev` و `npm run preview`: نشانی بک‌اند محلی برای پروکسی.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
