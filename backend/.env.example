# --- Application ---
# مقدارها عمداً خالی هستند؛ .env را پر کنید.
NODE_ENV=
PORT=
HOST=
APP_URL=
# اگر API روی دامنه‌ی جداگانه‌ای است، نشانی عمومی خود API
PUBLIC_API_URL=
ADMIN_EMAIL=
ADMIN_ALERT_EMAIL=
# فقط برای اسکریپت seed؛ در محیط اجرا لازم نیست.
ADMIN_PASSWORD=
LOG_LEVEL=
TRUST_PROXY=
COOKIE_SECURE=
SESSION_TTL_HOURS=

# --- Database ---
DATABASE_URL=
# فقط برای docker-compose
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Secrets (مقدار واقعی را هرگز کامیت نکنید) ---
# حداقل ۳۲ نویسه‌ی تصادفی
SESSION_SECRET=
# دقیقاً ۳۲ بایت base64؛ نمونه‌ی تولید: openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- PayPing (اختیاری) ---
PAYPING_TOKEN=
